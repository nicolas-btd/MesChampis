# Environnements virtuels Python
.venv/
env/
venv/
ENV/

# Caches et fichiers temporaires Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Données brutes volumineuses IGN (BD Forêt & BD ALTI)
data/raw/*
!data/raw/bdforet/
!data/raw/bdalti/
data/raw/bdforet/*
!data/raw/bdforet/.gitkeep
data/raw/bdalti/*
!data/raw/bdalti/.gitkeep

# Données générées / exports
data/out/*
!data/out/.gitkeep

# Données web synchronisées
web/data/*
!web/data/.gitkeep
!web/data/especes.json
# Tuiles de la grille 25 m (~46 Mo) : versionnées pour que l'appli marche dès le clone
!web/data/grille/

# Fichiers système et IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
